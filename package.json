{
  "name": "nestjs-swagger-drift",
  "version": "0.0.0",
  "description": "Static analysis for NestJS controllers: fails CI when a handler can produce an HTTP status code that isn't documented with an @ApiResponse-family decorator.",
  "keywords": [
    "nestjs",
    "swagger",
    "openapi",
    "lint",
    "static-analysis",
    "api-response"
  ],
  "license": "MIT",
  "author": "Ivan Dutov",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nestjs-swagger-drift": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "nest-common-snapshot": "npm:@nestjs/common@^11.1.28",
    "nest-swagger-snapshot": "npm:@nestjs/swagger@^11.4.6",
    "prettier": "^3.9.6",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
