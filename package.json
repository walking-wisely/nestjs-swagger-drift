{
  "name": "nestjs-swagger-drift",
  "version": "0.1.0",
  "description": "Static analysis for NestJS controllers: fails CI when a handler can produce an HTTP status code that isn't documented with an @ApiResponse-family decorator.",
  "keywords": [
    "nestjs",
    "swagger",
    "openapi",
    "lint",
    "static-analysis",
    "api-response"
  ],
  "license": "MIT",
  "author": "Ivan Dutov",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walking-wisely/nestjs-swagger-drift.git"
  },
  "bugs": {
    "url": "https://github.com/walking-wisely/nestjs-swagger-drift/issues"
  },
  "homepage": "https://github.com/walking-wisely/nestjs-swagger-drift#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "default": "./dist/eslint/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nestjs-swagger-drift": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "@typescript-eslint/utils": "^8.0.0",
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": ">=5.0.0 <7.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "@typescript-eslint/utils": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "js-yaml": "^5.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/picomatch": "^4.0.3",
    "@typescript-eslint/parser": "^8.66.0",
    "@typescript-eslint/rule-tester": "^8.66.0",
    "@typescript-eslint/utils": "^8.66.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "nest-common-snapshot": "npm:@nestjs/common@^11.1.28",
    "nest-swagger-snapshot": "npm:@nestjs/swagger@^11.4.6",
    "prettier": "^3.9.6",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "picomatch": "^4.0.5"
  }
}
